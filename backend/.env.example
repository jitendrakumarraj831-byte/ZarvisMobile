# Copy to .env to configure real credentials. The server runs fully functional against
# mocks with NO .env file at all — see ../AI_ARCHITECTURE.md and ../DEVELOPMENT.md.

PORT=3000

# Postgres connection string (POSTGRES_URL takes precedence over DATABASE_URL — Vercel
# Postgres/Neon set POSTGRES_URL automatically once the store is attached to the project).
# Leave unset to use the in-memory store — fine for local dev/tests, but on a serverless
# host like Vercel its state does not survive a cold start, which breaks refresh tokens and
# everything behind requireAuth soon after signup/login. See src/store/postgresStore.ts.
POSTGRES_URL=
DATABASE_URL=

# JWT signing secret for issued access/refresh tokens. A dev default is used if unset in
# development/test — but the server refuses to start with NODE_ENV=production unless this
# is set to a real, random value (src/config/env.ts), since the dev default is a known
# public string and every issued token would otherwise be forgeable.
JWT_SECRET=

# Google Gemini — this repository's wired, real AIProvider (see ../AI_ARCHITECTURE.md).
# Set GEMINI_API_KEY to switch the orchestrator's default provider from MockAIProvider to
# live Gemini calls with zero code changes. Get a key from https://aistudio.google.com/apikey.
# GEMINI_MODEL only needs setting to override the default (config/env.ts).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# OpenRouter — the AI Model Gateway's second provider and Gemini's fallback (see
# ../AI_MODEL_GATEWAY.md). Leave OPENROUTER_API_KEY empty to run on Gemini alone. With a key set
# and nothing else, a request that fails on Gemini for a TEMPORARY reason (rate limit, exhausted
# quota, outage, timeout) is tried once more on OpenRouter, but only if the OpenRouter model
# declares everything that request needs. Get a key at https://openrouter.ai/keys.
# Server-side only: never put it in the web client, the Android app or a log.
OPENROUTER_API_KEY=

# NOTE for existing deployments: before the AI Model Gateway, OPENROUTER_MODEL defaulted to
# google/gemini-2.0-flash-001. The default is now openrouter/free, which declares no tool support, so a
# tool-using chat turn is not sent to it. To keep the old behaviour set both:
#   OPENROUTER_MODEL=google/gemini-2.0-flash-001
#   OPENROUTER_MODEL_CAPABILITIES=tools,vision   (only after checking the model supports them)

# Optional OpenRouter settings (defaults shown). Uncomment to change.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openrouter/free
# What that model can do BESIDE text and streaming. Nothing is assumed: free models differ widely,
# and a request that needs a capability the model does not declare is never sent to it. A
# comma-separated list from: tools, vision, structuredOutput, coding, reasoning. Without "tools"
# the planner (every tool-using chat turn) does not fall back to OpenRouter; plain generation does.
# Declare a capability only after checking the chosen model really supports it.
# OPENROUTER_MODEL_CAPABILITIES=
# OPENROUTER_MODEL_CONTEXT_TOKENS=32768
# One request's time budget, headers AND body (a stream is also given up after 30 s of silence).
# OPENROUTER_TIMEOUT_MS=60000

# Live model list (default on). OpenRouter's free models come and go; with this on, the gateway reads
# OpenRouter's own list (lazily, only when OpenRouter is about to be used), replaces a model that is
# no longer offered, and takes capabilities from the list. false = use only the model declared above.
# OPENROUTER_DISCOVERY=true
# Up to two more model ids tried, in the same request, if the main model fails.
# OPENROUTER_FALLBACK_MODELS=
# Cost controls. Free models only unless OPENROUTER_ALLOW_PAID=true. Price ceilings are US dollars per
# million tokens and also go to OpenRouter as provider.max_price. The output cap bounds every reply.
# OPENROUTER_ALLOW_PAID=false
# OPENROUTER_MAX_PRICE_PROMPT=
# OPENROUTER_MAX_PRICE_COMPLETION=
# OPENROUTER_MAX_OUTPUT_TOKENS=
# allow | deny: may a provider that stores or trains on prompts answer? deny also applies to web search
# and can leave no free model at all. Unset = the OpenRouter account's own setting.
# OPENROUTER_DATA_COLLECTION=

# Provider selection. Defaults: gemini is the primary, and the other provider is the fallback.
# AI_PRIMARY_PROVIDER=gemini        # gemini | openrouter
# AI_FALLBACK_PROVIDER=openrouter   # openrouter | gemini | none (none switches the fallback off)
# After a provider reports an exhausted quota it is skipped for this long (milliseconds), but only
# while a fallback that can serve the request exists. 0 turns the cooldown off.
# AI_QUOTA_COOLDOWN_MS=300000
# Describe several models at once (replaces OPENROUTER_MODEL / OPENROUTER_MODEL_CAPABILITIES). A JSON
# array on ONE line, in quotes. Anything not stated is the conservative value (no capability, 32k
# context). Unknown keys are rejected at startup.
# AI_MODEL_CATALOG_JSON='[{"provider":"openrouter","model":"openrouter/free","enabled":true,"free":true,"streaming":true,"tools":false,"vision":false,"priority":2}]'

# Spoken replies (POST /api/v1/tts/synthesize and /synthesize-stream): Microsoft Edge's neural
# voices speak. They need no API key and no account. The voice is chosen from the text: Devanagari
# -> Hindi voice, Hindi in Latin letters (Hinglish) -> Hinglish voice, anything else -> English
# voice. The Edge service is unofficial and has changed before, so when it fails before any sound
# Gemini's voice speaks instead (same GEMINI_API_KEY as chat, no extra credential). That sends the
# sentence to Google: set TTS_FALLBACK_PROVIDER=none to keep it on Edge only. See
# AI_MODEL_GATEWAY.md "Spoken replies".
# TTS_PROVIDER=edge             # edge (default) | gemini (Gemini's voice only) | none (no spoken replies)
# TTS_FALLBACK_PROVIDER=gemini  # gemini (default, needs GEMINI_API_KEY) | none
# TTS_HI_VOICE=hi-IN-SwaraNeural
# TTS_EN_VOICE=en-US-JennyNeural
# Hindi written in Latin letters ("aaj kya karna hai"). Defaults to TTS_HI_VOICE; an Indian-English
# voice such as en-IN-NeerjaNeural is the usual alternative.
# TTS_HINGLISH_VOICE=hi-IN-SwaraNeural
# Gemini's voice, used as the fallback (or alone with TTS_PROVIDER=gemini). TTS quotas are per model.
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# GEMINI_TTS_VOICE=Kore         # Kore | Puck | Charon | Aoede | Fenrir

# Allowed browser origins for cross-origin calls (the web client itself is same-origin).
CORS_ORIGINS=https://zarvismobile.com,https://www.zarvismobile.com,http://localhost:3000,http://localhost:5173

# Developer Agent GitHub access is per user: each account connects its OWN GitHub token in the
# app (POST /api/v1/integrations/github), stored AES-256-GCM encrypted with this key. There is
# no shared server GitHub token. Required in production (base64 of 32 random bytes, e.g.
# `openssl rand -base64 32`); without it, GitHub connection is reported unavailable.
INTEGRATION_ENCRYPTION_KEY=

# Postgres TLS certificate verification is ON by default. For a provider with a private CA,
# put its PEM here. POSTGRES_SSL_MODE=no-verify is an explicit, logged opt-out (not recommended).
POSTGRES_CA_CERT=
POSTGRES_SSL_MODE=

# Google Play Billing server verification (see ../SUBSCRIPTIONS.md). Set
# PLAY_BILLING_SERVICE_ACCOUNT_JSON to the full JSON key contents of a service account
# granted access to the app in Play Console (Setup > API access) to switch the billing
# webhook from the built-in mock verifier to real Google Play Developer API verification.
PLAY_BILLING_SERVICE_ACCOUNT_JSON=
PLAY_BILLING_PACKAGE_NAME=com.zarvismobile.app

# Razorpay — UPI, cards, netbanking and wallets in INR (https://dashboard.razorpay.com/app/keys).
# Leave unset and the Plans page honestly says payments are not enabled. Use rzp_test_* keys
# while testing. Webhook: add https://<your-domain>/api/v1/billing/razorpay/webhook in
# Razorpay Dashboard > Webhooks with events payment.captured and order.paid, and set the same
# secret below. Prices are whole rupees; credits are granted per paid period. All server-side.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PRICE_PRO_MONTHLY_INR=499
PRICE_PRO_YEARLY_INR=4999
PRO_CREDITS_MONTHLY=1000
PRO_CREDITS_YEARLY=12000

# Sign in with Google (https://console.cloud.google.com/apis/credentials > OAuth client ID > Web
# application). Add your site (https://zarvismobile.com and any preview URL) under "Authorized
# JavaScript origins". Only the public client id is needed - no secret. Leave unset and the
# sign-in card offers email/password only. Google shares just name, email and photo.
GOOGLE_CLIENT_ID=
