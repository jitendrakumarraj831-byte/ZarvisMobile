# Copy to .env to configure real credentials. The server runs fully functional against
# mocks with NO .env file at all — see ../AI_ARCHITECTURE.md and ../DEVELOPMENT.md.

PORT=3000

# JWT signing secret for issued access/refresh tokens. A dev default is used if unset —
# never rely on that default outside local development.
JWT_SECRET=

# AI provider credentials (never bundled in the mobile app — see ../SECURITY.md).
# Leave unset to use the built-in MockAIProvider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Google Gemini — this repository's wired, real AIProvider (see ../AI_ARCHITECTURE.md).
# Set GEMINI_API_KEY to switch the orchestrator's default provider from MockAIProvider to
# live Gemini calls with zero code changes. Get a key from https://aistudio.google.com/apikey.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Official production domain and allowed browser origins for the web client (see
# ../MASTER_SPEC.md §12a "Web Client Architecture"). Defaults already cover
# zarvismobile.com + local dev, override only for a different deployment target.
PUBLIC_APP_URL=https://zarvismobile.com
CORS_ORIGINS=https://zarvismobile.com,https://www.zarvismobile.com,http://localhost:3000,http://localhost:5173

# GitHub App / OAuth credentials for the Developer Agent (see ../DEVELOPER_AGENT.md).
# Leave unset to use the built-in mock GitHub client.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# Google Play Billing server verification (see ../SUBSCRIPTIONS.md).
# Leave unset to use the built-in mock verifier.
PLAY_BILLING_SERVICE_ACCOUNT_JSON=
