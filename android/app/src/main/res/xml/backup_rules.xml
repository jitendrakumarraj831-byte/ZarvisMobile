<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 8–11 counterpart of data_extraction_rules.xml (which only applies from Android 12).
  android:allowBackup="false" already disables backup there; these rules say the same thing
  explicitly so no ZARVIS data is ever included if that flag is changed.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
