{
  "version": 2,
  "headers": [
    {
      "source": "/(app\\.js|logic\\.js|feature-pages\\.js|shell\\.js|theme-init\\.js|i18n\\.js|styles\\.css|sw\\.js|index\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, max-age=0, must-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://checkout.razorpay.com https://accounts.google.com/gsi/client; style-src 'self' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.razorpay.com https://*.googleusercontent.com; media-src 'self' blob:; connect-src 'self' https://api.razorpay.com https://lumberjack.razorpay.com https://checkout.razorpay.com https://accounts.google.com/gsi/; frame-src https://api.razorpay.com https://checkout.razorpay.com https://accounts.google.com/gsi/; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://api.razorpay.com; frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), microphone=(self)"
        }
      ]
    }
  ],
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "web/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/$",
      "dest": "/web/index.html"
    },
    {
      "src": "^/app\\.js$",
      "dest": "/web/app.js"
    },
    {
      "src": "^/logic\\.js$",
      "dest": "/web/logic.js"
    },
    {
      "src": "^/feature-pages\\.js$",
      "dest": "/web/feature-pages.js"
    },
    {
      "src": "^/shell\\.js$",
      "dest": "/web/shell.js"
    },
    {
      "src": "^/theme-init\\.js$",
      "dest": "/web/theme-init.js"
    },
    {
      "src": "^/i18n\\.js$",
      "dest": "/web/i18n.js"
    },
    {
      "src": "^/styles\\.css$",
      "dest": "/web/styles.css"
    },
    {
      "src": "^/manifest\\.webmanifest$",
      "dest": "/web/manifest.webmanifest"
    },
    {
      "src": "^/sw\\.js$",
      "dest": "/web/sw.js"
    },
    {
      "src": "^/icons/(.*)$",
      "dest": "/web/icons/$1"
    },
    {
      "src": "^/(api/.*|health)$",
      "dest": "/api/index.ts"
    },
    {
      "src": "^/(.*)$",
      "dest": "/web/index.html"
    }
  ]
}
